datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TRAVELER
  OPERATOR
  AUDITOR
  GOVERNMENT
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  OPERATOR_VERIFIED
  AUDITOR_VERIFIED
  COMMUNITY_CONFIRMED
  NEEDS_REVIEW
}

enum OperationalStatus {
  OPERATIONAL
  TEMPORARILY_UNAVAILABLE
  CLOSED
  UNKNOWN
}

enum KnowledgeStatus {
  VERIFIED
  UNVERIFIED
  UNKNOWN
  CONFLICTING
}

enum JourneyFeasibility {
  FEASIBLE
  NOT_FEASIBLE
  UNKNOWN
}

enum NodeType {
  HOME
  STATION
  AIRPORT
  HOTEL
  STADIUM
  ATTRACTION
  RESTAURANT
  ENTRANCE
  GATE
  TOILET
  SEATING
  PARKING
  TRAINING_FACILITY
}

enum EdgeType {
  WALKING
  ROAD_TAXI
  BUS
  METRO
  TRAIN
  SHUTTLE
  RAMP
  ELEVATOR
  CORRIDOR
  TRANSFER
}

model User {
  id            String                 @id @default(uuid())
  email         String                 @unique
  name          String
  role          Role                   @default(TRAVELER)
  profiles      AccessibilityProfile[]
  reports       AccessibilityReport[]
  verifications VerificationRecord[]
  created_at    DateTime               @default(now())
}

model AccessibilityProfile {
  id                          String   @id @default(uuid())
  user_id                     String
  user                        User     @relation(fields: [user_id], references: [id])
  title                       String
  is_default                  Boolean  @default(false)
  requires_step_free          Boolean  @default(true)
  requires_accessible_vehicle Boolean  @default(true)
  requires_accessible_toilet  Boolean  @default(true)
  requires_wheelchair_seating Boolean  @default(false)
  requires_elevator           Boolean  @default(false)
  requires_low_noise          Boolean  @default(false)
  requires_visual_info        Boolean  @default(false)
  requires_audio_info         Boolean  @default(false)
  max_slope_percent           Float    @default(5.0)
  max_walking_distance_m      Int      @default(500)
  created_at                  DateTime @default(now())
}

model PlaceNode {
  id                    String             @id @default(uuid())
  name                  String
  node_type             NodeType
  city                  String
  latitude              Float
  longitude             Float
  address               String
  step_free_access      Boolean            @default(true)
  has_accessible_toilet Boolean            @default(true)
  has_elevator          Boolean            @default(false)
  has_wheelchair_seating Boolean           @default(false)
  verification_status   VerificationStatus @default(UNVERIFIED)
  knowledge_status      KnowledgeStatus    @default(UNVERIFIED)
  confidence_score      Int                @default(80)
  last_verified_at      DateTime           @default(now())
  outgoing_edges        EdgeConnection[]   @relation("SourceNode")
  incoming_edges        EdgeConnection[]   @relation("TargetNode")
  reports               AccessibilityReport[]
  created_at            DateTime           @default(now())
}

model EdgeConnection {
  id                  String            @id @default(uuid())
  source_node_id      String
  source_node         PlaceNode         @relation("SourceNode", fields: [source_node_id], references: [id])
  target_node_id      String
  target_node         PlaceNode         @relation("TargetNode", fields: [target_node_id], references: [id])
  edge_type           EdgeType
  distance_meters     Int
  duration_seconds    Int
  is_step_free        Boolean           @default(true)
  slope_percent       Float             @default(0.0)
  vehicle_accessible  Boolean           @default(false)
  operational_status  OperationalStatus @default(OPERATIONAL)
  confidence_score    Int               @default(90)
  last_verified_at    DateTime          @default(now())
}

model LiveCondition {
  id              String            @id @default(uuid())
  target_type     String            // "NODE" or "EDGE"
  target_id       String
  title           String
  description     String
  status          OperationalStatus @default(TEMPORARILY_UNAVAILABLE)
  reported_at     DateTime          @default(now())
  expires_at      DateTime?
  source          String            // "OPERATOR", "COMMUNITY", "SYSTEM"
}

model AccessibilityReport {
  id          String   @id @default(uuid())
  place_id    String
  place       PlaceNode @relation(fields: [place_id], references: [id])
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  issue_type  String
  description String
  image_url   String?
  status      String   @default("PENDING")
  timestamp   DateTime @default(now())
}

model VerificationRecord {
  id            String   @id @default(uuid())
  place_id      String
  auditor_id    String
  auditor       User     @relation(fields: [auditor_id], references: [id])
  evidence_type String
  notes         String
  created_at    DateTime @default(now())
}
